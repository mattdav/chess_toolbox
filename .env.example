# chess_toolbox — variables d'environnement
# Copier ce fichier en .env et renseigner les valeurs réelles.
# Le fichier .env ne doit JAMAIS être committé.

# ── extract-chessable / Firefox ────────────────────────────────────────────
#
# Le scraper utilise Firefox (navigateur réel) pour contourner Cloudflare.
# Firefox doit être installé normalement — pas besoin d'une version spéciale.
#
# ── Chemin vers Firefox (optionnel si dans Program Files) ─────────────────
# Laisser vide = détection automatique dans les emplacements standards Windows.
# FIREFOX_BINARY_PATH=C:/Program Files/Mozilla Firefox/firefox.exe

# ── Répertoire de profil Firefox dédié au scraping ────────────────────────
# Profil séparé du profil Firefox normal — pas de conflit même si Firefox
# est déjà ouvert. Firefox le crée s'il n'existe pas.
FIREFOX_AUTOMATION_PROFILE_DIR=C:/tools/firefox-automation-profile

# ── Cache et sorties ───────────────────────────────────────────────────────
CHESSABLE_HTML_CACHE=./html/
CHESSABLE_PGN_CACHE=./pgn/

# ── Mode de fenêtre Firefox ────────────────────────────────────────────────
# offscreen (défaut) = fenêtre réelle mais positionnée hors de tout écran
#   physique. Invisible pour l'utilisateur, sans les particularités de
#   rendu/fingerprint du vrai mode headless — recommandé une fois connecté.
# headless = sans fenêtre du tout (--headless Firefox).
# visible  = fenêtre normale visible à l'écran.
#   → Recommandé lors de la première utilisation pour se connecter à Chessable.
CHESSABLE_WINDOW_MODE=offscreen

# ── GeckoDriver (optionnel) ───────────────────────────────────────────────
# Selenium Manager télécharge GeckoDriver automatiquement si absent.
# Décommenter uniquement si un chemin spécifique est nécessaire.
# GECKODRIVER_PATH=C:/tools/geckodriver/geckodriver.exe
