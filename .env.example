# chess_toolbox — variables d'environnement
# Copier ce fichier en .env et renseigner les valeurs réelles.
# Le fichier .env ne doit JAMAIS être committé.

# ── chessable_to_pgn ───────────────────────────────────────────────────────
#
# IMPORTANT : utiliser Chrome for Testing (CfT), PAS Chrome normal.
#
# Chrome normal ne peut pas être piloté par Selenium quand une instance
# utilisateur est déjà ouverte : il délègue silencieusement au processus
# existant, qui lui n'a pas été lancé avec les flags Selenium → crash
# "DevToolsActivePort file doesn't exist".
#
# Chrome for Testing est un binaire isolé sans ce comportement.
# Téléchargement (choisir la version Stable, plateforme win64) :
#   https://googlechromelabs.github.io/chrome-for-testing/
#
# Installation conseillée :
#   1. Télécharger l'archive "chrome" ET "chromedriver" pour win64
#   2. Extraire dans C:/tools/chrome-for-testing/
#   3. Vérifier que chrome.exe et chromedriver.exe sont dans ce dossier
#
# ── Chemin vers Chrome for Testing ────────────────────────────────────────
CHROME_BINARY_PATH=C:/tools/chrome-for-testing/chrome.exe

# ── Chromedriver (optionnel si dans le même dossier que chrome.exe) ───────
# Si chromedriver.exe est dans un autre dossier, le préciser ici.
# Sinon, laisser vide : WebFetch.py le localise automatiquement.
CHROMEDRIVER_PATH=

# ── Répertoire de données utilisateur pour CfT ────────────────────────────
# Dossier dédié à CfT — ne pas pointer vers le profil Chrome normal
# (risque de conflits de verrouillage de fichiers).
# CfT crée ce dossier s'il n'existe pas.
CHROME_PROFILE_DIR=C:/tools/chrome-for-testing/user-data

# Nom du profil CfT (défaut : Default)
CHROME_PROFILE=Default

# ── Cache et sorties ───────────────────────────────────────────────────────
CHESSABLE_HTML_CACHE=./html/
CHESSABLE_PGN_CACHE=./pgn/

# ── Mode headless ─────────────────────────────────────────────────────────
# false = fenêtre CfT visible.
#   → Recommandé lors de la première utilisation pour se connecter à Chessable
#     dans la fenêtre CfT et valider les cookies.
# true  = sans fenêtre (après la première connexion réussie).
CHESSABLE_HEADLESS=false

# ── Remote debugging (avancé — laisser à 0 en usage normal) ───────────────
# Ce mode connecte Selenium à un Chrome DÉJÀ ouvert via son port DevTools.
# Il ne fonctionne QUE si Chrome a été lancé depuis zéro avec le flag
# --remote-debugging-port, c'est-à-dire :
#   - Aucune autre instance Chrome ouverte avant le lancement
#   - Lancement via Invite de commandes (cmd.exe), PAS PowerShell
#     (PowerShell interprète & comme opérateur de pipeline)
#   - Commande exacte (cmd.exe) :
#     "C:\tools\chrome-for-testing\chrome.exe" --remote-debugging-port=9222
#
# Vérifier que Chrome écoute bien sur le port avant de démarrer le script :
#   netstat -an | findstr 9222
#   → doit afficher une ligne TCP 0.0.0.0:9222 en LISTENING
#
# En pratique le mode CfT normal (CHESSABLE_DEBUG_PORT=0) est plus simple
# et plus fiable. N'utiliser ce mode que si CfT ne parvient pas à se
# connecter automatiquement à Chessable.
CHESSABLE_DEBUG_PORT=0

# ── Cookies Chessable (curl_cffi) ──────────────────────────────────────────
# Fichier JSON des cookies exportés depuis un vrai navigateur avec Cookie-Editor.
# curl_cffi utilise ces cookies pour contourner Cloudflare sans navigateur.
#
# Workflow :
#   1. Se connecter à Chessable dans Chrome/Firefox
#   2. Exporter les cookies avec Cookie-Editor (format JSON)
#   3. uv run chess_toolbox chessable-import-cookies cookies.json
#
# Par défaut, les cookies sont sauvegardés dans ./chessable_cookies.json.
# Décommenter pour pointer vers un autre emplacement.
# CHESSABLE_COOKIES_FILE=./chessable_cookies.json
